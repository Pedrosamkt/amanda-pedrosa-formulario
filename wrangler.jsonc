{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amanda-pedrosa",
  "compatibility_date": "2026-10-29",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  }
}
